# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string (mật khẩu mặc định thống nhất trong nhóm: 123456)
# Nếu máy bạn dùng mật khẩu khác, sửa lại chỗ 123456 sau khi copy sang file .env
DATABASE_URL="postgresql://postgres:123456@localhost:5432/quizguard?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Optional: Gemini API (cho Giai đoạn 4)
GEMINI_API_KEY=""
